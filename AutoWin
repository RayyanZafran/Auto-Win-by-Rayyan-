local function log(message)
    table.insert(
        logLines, 1,
        "[" .. os.date("%H:%M:%S") .. "] " .. message
    )

    while #logLines > 4 do
        table.remove(logLines)
    end

    logBox.Text = table.concat(logLines, "\n")
end

