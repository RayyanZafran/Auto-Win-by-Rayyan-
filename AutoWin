-- AUTO WIN
local function startAutoWin()
    loopToken += 1
    local myToken = loopToken

    task.spawn(function()
        while enabled and loopToken == myToken do
            local character = player.Character

            if not character then
                setStatus("RESPAWN", ORANGE)
                log("Waiting for character")
                character = player.CharacterAdded:Wait()
            end

            if not enabled or loopToken ~= myToken then
                break
            end

            local humanoid = character:WaitForChild("Humanoid")
            local root = character:WaitForChild("HumanoidRootPart")

            if not enabled or loopToken ~= myToken then
                break
            end

            setStatus("TELEPORT", BLUE)
            log("Teleporting to target")

            -- Local teleport may be corrected by the server.
            root.CFrame = CFrame.new(TARGET_POSITION)

            task.wait(TELEPORT_DELAY)

            if not enabled or loopToken ~= myToken then
                break
            end

            setStatus("RESET", PURPLE)
            log("Resetting character")

            if humanoid.Health > 0 then
                humanoid.Health = 0
            end

            setStatus("RESPAWN", ORANGE)
            log("Waiting for respawn")

            local newCharacter = player.CharacterAdded:Wait()
            newCharacter:WaitForChild("Humanoid")
            newCharacter:WaitForChild("HumanoidRootPart")

            if not enabled or loopToken ~= myToken then
                break
            end

            task.wait(RESPAWN_DELAY)

            if not enabled or loopToken ~= myToken then
                break
            end

            cycles += 1
            cycleValue.Text = tostring(cycles)

            setStatus("ACTIVE", GREEN)
            log("Cycle " .. cycles .. " completed")

            task.wait(0.25)
        end
    end)
end

local function stopAutoWin()
    enabled = false
    loopToken += 1
    setStatus("IDLE", ORANGE)
    log("Auto Win disabled")
end

toggle.Activated:Connect(function()
    enabled = not enabled

    if enabled then
        toggle.Text = "ON"
        toggle.BackgroundColor3 = GREEN
        setStatus("ACTIVE", GREEN)
        log("Auto Win enabled")
        startAutoWin()
    else
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(71, 40, 83)
        stopAutoWin()
    end
end)

